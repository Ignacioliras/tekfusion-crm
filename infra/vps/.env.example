# Plantilla del .env del VPS (/opt/tekfusion/.env). Copiar a .env y completar
# TODOS los valores. El .env real nunca entra al repo: va al servidor y a la
# bóveda (Bitwarden). Claves: `openssl rand -hex 32` (solo hex, sin símbolos,
# porque las contraseñas de las bases van dentro de una URL). Las claves vienen
# vacías a propósito: `docker compose config` falla mientras falte alguna.

# --- General ---
# staging o prod. Arma los dominios: evolution.<ENV_NAME>.tekfusion.cl, etc.
ENV_NAME=staging
# Correo para avisos de Let's Encrypt (casilla de Libux que administra el VPS).
ACME_EMAIL=infra@example.com
TZ=America/Santiago

# --- Evolution API ---
# AUTHENTICATION_API_KEY global de Evolution (la usan el CRM y n8n para llamarla).
# Pegar aquí una clave nueva de `openssl rand -hex 32`.
EVOLUTION_API_KEY=
# URL de la Edge Function receptora del proyecto de Supabase de este ambiente.
EVOLUTION_WEBHOOK_URL=https://ref-del-proyecto.supabase.co/functions/v1/whatsapp-webhook
# Webhook global apagado: se configura por instancia con el header apikey (README).
EVOLUTION_WEBHOOK_GLOBAL_ENABLED=false
EVOLUTION_DB_USER=evolution
# Pegar aquí otra clave nueva de `openssl rand -hex 32`.
EVOLUTION_DB_PASSWORD=
EVOLUTION_DB_NAME=evolution

# --- n8n ---
# Sin esta clave los respaldos de n8n no sirven: guardarla en la bóveda.
# Pegar aquí otra clave nueva de `openssl rand -hex 32`.
N8N_ENCRYPTION_KEY=
N8N_DB_USER=n8n
# Pegar aquí otra clave nueva de `openssl rand -hex 32`.
N8N_DB_PASSWORD=
N8N_DB_NAME=n8n
