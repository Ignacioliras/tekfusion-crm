    {
      "id": "f02-ai",
      "name": "Clasificar con IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 0],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "anthropic-version", "value": "2023-06-01" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-haiku-5-5', max_tokens: 512, system: 'PEGAR AQUÍ n8n/prompts/clasificar-lead.md', messages: [{ role: 'user', content: String($json.text ?? '(sin texto: ' + $json.type + ')').slice(0, 4096) }] }) }}",
        "options": {}
      },
      "credentials": {
        "anthropicApi": { "name": "Anthropic" }
      }
    },
    {
      "id": "f02-validate",
      "name": "Validar salida IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [620, 0],
      "parameters": {
        "jsCode": "// The classifier only classifies: anything off-schema becomes 'indeterminada'.\nconst LINES = ['valvulas', 'tuberias', 'geoceldas', 'indeterminada'];\nconst source = $('Primer mensaje').all();\nreturn $input.all().map(({ json }, i) => {\n  let out = null;\n  try { out = JSON.parse(json.content?.[0]?.text ?? ''); } catch {}\n  const valid = out && LINES.includes(out.linea) && typeof out.confianza === 'number' && out.confianza >= 0 && out.confianza <= 1 && typeof out.es_spam === 'boolean';\n  const str = (v, max) => (typeof v === 'string' && v.trim() ? v.trim().slice(0, max) : null);\n  const ai = valid\n    ? { linea: out.linea, confianza: out.confianza, es_spam: out.es_spam, empresa: str(out.empresa, 200), nombre: str(out.nombre, 200), correo: str(out.correo, 254), necesidad: str(out.necesidad, 200) }\n    : { linea: 'indeterminada', confianza: 0, es_spam: false, invalid_ai_output: true };\n  return { json: { conversation_id: source[i].json.conversation_id, ai } };\n});"
      }
    },
    {
      "id": "f02-lead",
      "name": "Crear lead (RPC ingest_whatsapp_lead, pendiente)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
