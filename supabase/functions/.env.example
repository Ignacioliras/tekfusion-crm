# Variables para `npx supabase functions serve` en local.
# Copiar a supabase/functions/.env (ignorado por git).
# Los valores son los por defecto del CLI de Supabase en local: nunca poner aquí
# secretos de staging ni de producción (esos van en `supabase secrets`).
SB_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
# Valor "Publishable" que muestra `npx supabase status`.
SB_PUBLISHABLE_KEY=

# URL pública del CRM: la usa la app MCP de lista de tareas para enlazar los
# nombres de contacto al CRM. Vacía = nombres como texto plano.
CRM_BASE_URL=http://localhost:5173

# Secreto que Evolution manda en el header `apikey` al webhook de WhatsApp
# (función whatsapp-webhook). Vacío = la función responde 401 a todo.
EVOLUTION_WEBHOOK_SECRET=

# Secreto propio de la purga de adjuntos (función purge-orphan-attachments): el
# job de pg_cron lo manda en `Authorization: Bearer`. Vacío = la función
# responde 401 a todo. En local, este valor es el que usan los e2e
# (e2e/tekfusion/purga-adjuntos.spec.ts); en staging y producción lo genera
# Ignacio y va en `supabase secrets` y en Vault, nunca aquí.
PURGE_CRON_SECRET=solo-para-e2e-local
