# Variables para `npx supabase functions serve` en local.
# Copiar a supabase/functions/.env (ignorado por git).
# Los valores son los por defecto del CLI de Supabase en local: nunca poner aquí
# secretos de staging ni de producción (esos van en `supabase secrets`).
SB_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
# Valor "Publishable" que muestra `npx supabase status`.
SB_PUBLISHABLE_KEY=

# URL pública del CRM: la usa la app MCP de lista de tareas para enlazar los
# nombres de contacto al CRM. Vacía = nombres como texto plano.
CRM_BASE_URL=http://localhost:5173
