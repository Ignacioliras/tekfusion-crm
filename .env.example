# Local: NO hace falta este archivo. Atomic trae `.env.development` con las claves
# del Supabase local (`npx supabase start`). Este ejemplo es para staging/producción:
# copiar a `.env.staging` / `.env.production` (ignorados por git) o cargar en Cloudflare Pages.

# ── Frontend (Vite) — nombres que usa Atomic CRM ────────────────
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SB_PUBLISHABLE_KEY=      # clave publicable (sb_publishable_…) del proyecto
VITE_IS_DEMO=false
VITE_ATTACHMENTS_BUCKET=attachments
VITE_APP_ENV=staging          # staging | production

# ── Supabase Edge Functions (secrets: `supabase secrets set`) ────
SUPABASE_SERVICE_ROLE_KEY=    # la inyecta Supabase en las Edge Functions; nombre que usa Atomic
EVOLUTION_API_URL=https://evolution.staging.tekfusion.cl
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=tekfusion-staging
EVOLUTION_WEBHOOK_SECRET=     # header apikey que Evolution envía al webhook
STORAGE_BUCKET_COTIZACIONES=cotizaciones
STORAGE_BUCKET_ADJUNTOS=adjuntos-whatsapp

# ── n8n (variables del contenedor) ───────────────────────────────
N8N_HOST=n8n.staging.tekfusion.cl
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_URL=https://n8n.staging.tekfusion.cl/
GENERIC_TIMEZONE=America/Santiago
# Credenciales dentro de n8n (no en .env): Supabase service role, Evolution, Gmail IMAP,
# SMTP/IMAP por ejecutivo, Anthropic API key, Telegram (avisos a Libux).

# ── IA ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-latest

# ── Gmail de marketing (IMAP con contraseña de aplicación) ───────
GMAIL_IMAP_USER=marketingtekfusion@gmail.com
GMAIL_IMAP_APP_PASSWORD=
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993

# ── Evolution API (docker-compose) ───────────────────────────────
AUTHENTICATION_API_KEY=
DATABASE_CONNECTION_URI=postgresql://evolution:password@evolution-db:5432/evolution
WEBHOOK_GLOBAL_URL=https://xxxx.supabase.co/functions/v1/whatsapp-webhook
WEBHOOK_GLOBAL_ENABLED=true

# ── Uptime Kuma / avisos a Libux ─────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_LIBUX=
