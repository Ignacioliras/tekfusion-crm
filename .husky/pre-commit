npm run registry:gen
npx prettier --config ./.prettierrc.json --write "registry.json"
npx lint-staged
git update-index --again
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact || { echo "gitleaks encontró un posible secreto. Commit bloqueado."; exit 1; }
else
  echo "Aviso: gitleaks no está instalado; el CI igual escanea secretos. Instálalo: winget install Gitleaks.Gitleaks"
fi
